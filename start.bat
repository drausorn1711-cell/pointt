@echo off
chcp 65001 >nul
title ระบบสะสมแต้ม LINE OA - น้ำพริกแม่เฉลา
echo ========================================================
echo   🚀 กำลังเริ่มต้นระบบสะสมแต้ม (น้ำพริกแม่เฉลา)
echo ========================================================
echo.

rem เริ่มเซิร์ฟเวอร์ Node.js ในพื้นหลัง
start "Node Server" /min cmd /c "node server.js"

echo [1/2] เริ่มต้นเซิร์ฟเวอร์ภายในเครื่องแล้ว...
echo [2/2] กำลังเชื่อมต่อสัญญาณอินเทอร์เน็ต (Cloudflare Tunnel)...
echo.
echo --------------------------------------------------------
echo กรุณารอสักครู่ ระบบจะแสดงลิงก์ https://... ด้านล่างนี้:
echo (นำลิงก์ https://... ไปใส่ที่ Endpoint URL ใน LINE Developers)
echo --------------------------------------------------------
echo.

.\cloudflared.exe tunnel --url http://127.0.0.1:3000

pause
